local pickParams = RaycastParams.new()
pickParams.FilterType = Enum.RaycastFilterType.Exclude

local function onBuildPick(_, state, input)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end

	if placeArmed or not activeBuild or mode ~= "freeze" or held then
		return Enum.ContextActionResult.Pass
	end

	if overOwnUI(input.Position) then
		return Enum.ContextActionResult.Pass
	end

	local ray = inputRay(input)

	local char = player.Character
	pickParams.FilterDescendantsInstances = char and { char, ghostFolder } or { ghostFolder }

	local res = workspace:Raycast(
		ray.Origin,
		ray.Direction * 600,
		pickParams
	)

	if not res then
		return Enum.ContextActionResult.Pass
	end

	local item = ghostToItem[res.Instance]

	if not item then
		for _, it in ipairs(activeBuild.items) do
			if it.target and it.target.Parent
				and (res.Instance == it.target or res.Instance:IsDescendantOf(it.target)) then
				item = it
				break
			end
		end
	end

	if item then
		if not slotTaken(item) and not slotIsOccupied(item, item.target) then
			queueFly(item)
		end

		return Enum.ContextActionResult.Sink
	end

	return Enum.ContextActionResult.Pass
end

