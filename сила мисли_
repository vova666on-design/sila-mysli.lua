local linkFirst, linkHl = nil, nil

local function clearLinkSel()
	if linkHl then
		removeHighlight(linkHl)
	end

	linkFirst, linkHl = nil, nil
end

local function findLink(a, b)
	for _, holder in ipairs({ a, b }) do
		for _, w in ipairs(holder:GetChildren()) do
			if w:IsA("WeldConstraint") and w.Name == "TK_Link"
				and ((w.Part0 == a and w.Part1 == b)
				or (w.Part0 == b and w.Part1 == a)) then
				return w
			end
		end
	end

	return nil
end

local function pulse(part, color)
	local hl = addHighlight(part, color)
	flashHighlight(hl, 0.5)

	task.delay(0.8, function()
		removeHighlight(hl)
	end)
end

local function linkTap(part)
	if not canGrab(part) then
		clearLinkSel()
		return
	end

	if not linkFirst or not linkFirst.Parent then
		clearLinkSel()
		linkFirst = part
		linkHl = addHighlight(part, CFG.LinkColor)
		return
	end

	if linkFirst == part then
		clearLinkSel()
		return
	end

	local a, b = linkFirst, part
	clearLinkSel()

	-- Замороженные группы размораживаем, иначе они будут тянуть в разные стороны
	for _, p in ipairs({ a, b }) do
		local g = frozenByRoot[p.AssemblyRootPart]

		if g then
			unfreezeGroup(g)
		end
	end

	local w = findLink(a, b)

	if w then
		w:Destroy()
		pulse(a, CFG.HighlightColor)
		pulse(b, CFG.HighlightColor)
	else
		local weld = Instance.new("WeldConstraint")
		weld.Name = "TK_Link"
		weld.Part0 = a
		weld.Part1 = b
		weld.Parent = a

		pulse(a, CFG.LinkColor)
		pulse(b, CFG.LinkColor)
	end
end

