local function flyItem(item, onComplete)
	if item.flying then
		return false
	end

	if not bindItem(item) then
		local sb0 = item.ghost and item.ghost:FindFirstChildOfClass("SelectionBox")

		if sb0 then
			sb0.Color3 = Color3.fromRGB(255, 80, 80)
			sb0.LineThickness = 0.15

			TweenService:Create(sb0, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
				LineThickness = 0.05
			}):Play()

			task.delay(0.6, function()
				if sb0.Parent then
					sb0.Color3 = CFG.BuildColor
				end
			end)
		end

		return false
	end

	if held and held.target == item.target then
		stopHold(true)
	end

	if slotIsOccupied(item, item.target) then
		if onComplete then
			onComplete(false, "occupied")
		end

		return false
	end

	local live = {}

	for _, r in ipairs(item.roots) do
		if r.part and r.part.Parent and not r.part.Anchored then
			table.insert(live, r)
		end
	end

	if #live == 0 then
		return false
	end

	item.flying = true

	for _, r in ipairs(live) do
		local g = frozenByRoot[r.part]

		if g then
			unfreezeGroup(g)
		end
	end

	local entries = {}

	for _, r in ipairs(live) do
		local part = r.part

		local att = mk("Attachment", {
			Name = "TK_Attachment"
		}, part)

		local ap = mk("AlignPosition", {
			Mode = Enum.PositionAlignmentMode.OneAttachment,
			Attachment0 = att,
			ApplyAtCenterOfMass = true,
			MaxForce = math.huge,
			MaxVelocity = CFG.FlySpeed,
			Responsiveness = CFG.FlyResponsiveness,
			Position = r.cf.Position,
		}, part)

		local ao = mk("AlignOrientation", {
			Mode = Enum.OrientationAlignmentMode.OneAttachment,
			Attachment0 = att,
			CFrame = r.cf,
			MaxTorque = math.huge,
			Responsiveness = CFG.FlyResponsiveness,
		}, part)

		-- Светящийся след
		local a1 = mk("Attachment", {
			Position = Vector3.new(0, part.Size.Y / 2, 0)
		}, part)

		local a2 = mk("Attachment", {
			Position = Vector3.new(0, -part.Size.Y / 2, 0)
		}, part)

		local tr = mk("Trail", {
			Attachment0 = a1,
			Attachment1 = a2,
			Lifetime = 0.3,
			LightEmission = 1,
			FaceCamera = true,
			Color = ColorSequence.new(CFG.BuildColor),
			Transparency = NumberSequence.new(0.2, 1),
		}, part)

		-- На время полёта отключаем столкновения, чтобы ничто не мешало
		local coll = {}

		local okP, conn = pcall(function()
			return part:GetConnectedParts(true)
		end)

		if not okP then
			conn = { part }
		end

		for _, p in ipairs(conn) do
			if p:IsA("BasePart") and p.CanCollide then
				p.CanCollide = false
				table.insert(coll, p)
			end
		end

		table.insert(entries, {
			root = part,
			att = att,
			ap = ap,
			ao = ao,
			goal = r.cf,
			fx = { a1, a2, tr },
			coll = coll,
		})
	end

	local flyHl = addHighlight(item.target, CFG.BuildColor)

	task.spawn(function()
		local t0 = os.clock()

		while os.clock() - t0 < CFG.FlyTimeout do
			RunService.Heartbeat:Wait()

			local done = true

			for _, e in ipairs(entries) do
				if e.root.Parent
					and (e.root.Position - e.goal.Position).Magnitude > 0.6 then
					done = false
					break
				end
			end

			if done then
				break
			end
		end

		local g = {
			entries = {},
			hl = nil
		}

		for _, e in ipairs(entries) do
			-- Возвращаем столкновения
			for _, p in ipairs(e.coll) do
				if p.Parent then
					p.CanCollide = true
				end
			end

			if e.root.Parent then
				e.root.AssemblyLinearVelocity = Vector3.zero
				e.root.AssemblyAngularVelocity = Vector3.zero
				e.root.CFrame = e.goal
				e.ap.Position = e.goal.Position
				e.ap.MaxVelocity = 120
				e.ap.Responsiveness = CFG.Responsiveness
				e.ao.CFrame = e.goal
				e.ao.Responsiveness = CFG.Responsiveness

				frozenByRoot[e.root] = g
				table.insert(g.entries, e)
			else
				if e.ap then e.ap:Destroy() end
				if e.ao then e.ao:Destroy() end
				if e.att then e.att:Destroy() end
			end

			-- Убираем след
			local fx = e.fx

			if fx[3] then
				fx[3].Enabled = false
			end

			task.delay(0.5, function()
				for _, o in ipairs(fx) do
					o:Destroy()
				end
			end)
		end

		removeHighlight(flyHl)

		if #g.entries > 0 then
			g.hl = addHighlight(item.target, CFG.FreezeColor)
			table.insert(frozenGroups, g)

			task.delay(0.02, function()
				flashHighlight(g.hl, 0.7)
			end)

			-- Запоминаем, что это место теперь занято
			local d = item.dest or item
			d.placedRoot = g.entries[1].root
			d.placedGoal = g.entries[1].goal.Position
		end

		item.flying = false

		local sb = item.ghost and item.ghost:FindFirstChildOfClass("SelectionBox")

