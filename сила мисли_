task.spawn(function()
	if not canFile then
		warn("Сохранение построек недоступно: нет writefile/readfile")
		return
	end

	task.wait(1)

	if isfile(FILE) then
		local okR, text = pcall(readfile, FILE)
		local okD, decoded = false, nil

		if okR then
			okD, decoded = pcall(function()
				return HttpService:JSONDecode(text)
			end)
		end

		if not (okD and type(decoded) == "table") then
			warn("Не удалось прочитать файл построек, сохранение отключено, чтобы не стереть его")
			return
		end

		for _, rb in ipairs(decoded) do
			local b = {
				id = rb.id,
				name = rb.name,
				items = {},
				claimed = {}
			}

			for _, raw in ipairs(rb.items) do
				local boxCF = unpackCF(raw.bc)

				if boxCF and raw.bs and raw.r then
					table.insert(b.items, {
						raw = raw,
						boxCF = boxCF,
						boxSize = Vector3.new(table.unpack(raw.bs)),
						claimed = b.claimed,
					})
				end
			end

			buildCounter = math.max(buildCounter, b.id or 0)

			if #b.items > 0 then
				table.insert(builds, b)
				addRow(b)
			end
		end

		updateEmpty()
	end

	-- Сохраняем только когда что-то изменилось
	while true do
		task.wait(2)

		if dirty then
			dirty = false

			local ok = pcall(function()
				writefile(FILE, serialize())
			end)

			if not ok then
				dirty = true
			end
		end
	end
end)

