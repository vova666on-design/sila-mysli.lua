local function placeSelectedObject(part)
	if not placeArmed or mode ~= "freeze" or not activeBuild then
		return false
	end

	if not canGrab(part) then
		return false
	end

	local roots, top = collectObject(part)

	if #roots == 0 then
		return false
	end

	local target = top or part

	if placing[target] then
		return false
	end

	local tsize = sizeOf(target)

	for _, dest in ipairs(activeBuild.items) do
		if dest.roots
			and #dest.roots == #roots
			and not slotTaken(dest)
			and sameSize(tsize, dest.boxSize) then

			local temp = {
				target = target,
				dest = dest,
				roots = {}
			}

			for i, root in ipairs(roots) do
				table.insert(temp.roots, {
					part = root,
					cf = dest.roots[i].cf
				})
			end

			if not slotIsOccupied(temp, target) then
				-- Бронируем место сразу, чтобы быстрые нажатия не летели в одну точку
				dest.reserved = true
				placing[target] = true

				queueFly(temp, function()
					dest.reserved = false
					placing[target] = nil
				end)

				return true
			end
		end
	end

	return false
end

