local HttpService = game:GetService("HttpService")

local FILE = "TK_Builds_" .. game.PlaceId .. ".json"

local canFile =
	type(writefile) == "function"
	and type(readfile) == "function"
	and type(isfile) == "function"

local function pathOf(inst)
	local p = {}
	local cur = inst

	while cur and cur ~= workspace do
		if not cur.Parent then
			return nil
		end

		local idx = 1

		for _, s in ipairs(cur.Parent:GetChildren()) do
			if s == cur then
				break
			end

			if s.Name == cur.Name then
				idx += 1
			end
		end

		table.insert(p, 1, {
			n = cur.Name,
			i = idx
		})

		cur = cur.Parent
	end

	if cur ~= workspace then
		return nil
	end

	return p
end

local function resolve(p)
	local cur = workspace

	for _, s in ipairs(p) do
		local k = 0
		local found = nil

		for _, c in ipairs(cur:GetChildren()) do
			if c.Name == s.n then
				k += 1

				if k == s.i then
					found = c
					break
				end
			end
		end

		if not found then
			return nil
		end

		cur = found
	end

	return cur
end

local function packCF(cf)
	return { cf:GetComponents() }
end

local function unpackCF(t)
	if type(t) ~= "table" or #t ~= 12 then
		return nil
	end

	return CFrame.new(table.unpack(t))
end

---------------------------------------------------------------- ПОИСК ПРЕДМЕТОВ ПОСЛЕ ПЕРЕЗАХОДА
local function isLoose(inst)
	if inst:IsA("BasePart") then
		return not inst.Anchored
	end

	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") and not d.Anchored then
			return true
		end
	end

	return false
end

-- Кэш списка предметов (обновляется не чаще раза в 5 секунд)
local pool, poolT = nil, 0

local function getPool()
	if not pool or os.clock() - poolT > 5 then
		pool = {}

		local char = player.Character

		for _, d in ipairs(workspace:GetDescendants()) do
			if (d:IsA("Model") or d:IsA("BasePart"))
				and not d:IsDescendantOf(ghostFolder)
				and not (char and d:IsDescendantOf(char)) then

				table.insert(pool, d)
			end
		end

		poolT = os.clock()
	end

	return pool
end

local function findRoots(target, raw)
	local parts = {}

	if target:IsA("BasePart") then
		table.insert(parts, target)
	end

	for _, d in ipairs(target:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end

	local roots, used = {}, {}

	for _, r in ipairs(raw.r) do
		local nm = r.p[#r.p].n

		for _, p in ipairs(parts) do
			if p.Name == nm and not used[p] then
				local cf = unpackCF(r.cf)

				if cf then
					used[p] = true

					table.insert(roots, {
						part = p,
						cf = cf
					})
				end

				break
			end
		end
	end

	return roots
end

bindItem = function(item)
	if item.target and item.target.Parent and item.roots then
		return true
	end

	local raw = item.raw

	if not raw then
		return false
	end

	local used = item.claimed or {}

	local name = raw.t[#raw.t].n
	local cands = {}

	local exact = resolve(raw.t)

	if exact then
		table.insert(cands, exact)
	end

	for _, d in ipairs(getPool()) do
		if d.Parent and d.Name == name and d ~= exact then
			table.insert(cands, d)
		end
	end

	for _, c in ipairs(cands) do
		if not used[c]
			and isLoose(c)
			and not c:FindFirstChildOfClass("Humanoid")
			and item.boxSize
			and sameSize(sizeOf(c), item.boxSize) then

			local roots = findRoots(c, raw)

			if #roots > 0 then
				used[c] = true
				item.target = c
				item.roots = roots

				return true
			end
		end
	end

	return false
end

---------------------------------------------------------------- ЗАПИСЬ В ФАЙЛ
local function serialize()
	local out = {}

	for _, b in ipairs(builds) do
		local items = {}

		for _, it in ipairs(b.items) do
			local tp = it.target
				and it.target.Parent
				and pathOf(it.target)

			if tp and it.roots and it.boxCF and it.boxSize then
				local roots = {}

				for _, r in ipairs(it.roots) do
					local rp = r.part
						and r.part.Parent
						and pathOf(r.part)

					if rp and r.cf then
						table.insert(roots, {
							p = rp,
							cf = packCF(r.cf)
						})
					end
				end

				table.insert(items, {
					t = tp,
					bc = packCF(it.boxCF),
					bs = {
						it.boxSize.X,
						it.boxSize.Y,
						it.boxSize.Z
					},
					r = roots,
				})

			elseif it.raw then
				table.insert(items, it.raw)
			end
		end

		table.insert(out, {
			id = b.id,
			name = b.name,
			items = items
		})
	end

	return HttpService:JSONEncode(out)
end

