---------------------------------------------------------------- ОЧЕРЕДЬ ПОЛЁТОВ (по одному, друг за другом)
local flyQueue = {}
local flyWorker = false
local placing = {}

local function pumpQueue()
	if flyWorker then
		return
	end

	flyWorker = true

	task.spawn(function()
		while #flyQueue > 0 do
			local job = table.remove(flyQueue, 1)
			local finished = false

			local ok = flyItem(job.item, function(success, why)
				finished = true

				if job.cb then
					job.cb(success, why)
				end
			end)

			if ok then
				local t0 = os.clock()

				while not finished and os.clock() - t0 < CFG.FlyTimeout + 1 do
					RunService.Heartbeat:Wait()
				end
			elseif not finished and job.cb then
				job.cb(false)
			end

			job.item.queued = false
		end

		flyWorker = false
	end)
end

local function queueFly(item, cb)
	if item.queued then
		return false
	end

	item.queued = true
	table.insert(flyQueue, { item = item, cb = cb })
	pumpQueue()

	return true
end

local function clearQueue()
	for _, job in ipairs(flyQueue) do
		job.item.queued = false

		if job.cb then
			job.cb(false)
		end
	end

	table.clear(flyQueue)
	table.clear(placing)
end

