---------------------------------------------------------------- СКРЫТИЕ / ПОКАЗ КНОПОК
local menuOpen = true
local menuToken = 0
local panelCloseHook = nil
local COLLAPSED = UDim2.new(1, -12, 0, 10)

local menuItems = {
	{ btn = tkBtn, scale = tkScale, pos = tkBtn.Position },
	{ btn = frBtn, scale = frScale, pos = frBtn.Position },
	{ btn = pnBtn, scale = pnScale, pos = pnBtn.Position },
	{ btn = placeBtn, scale = placeScale, pos = placeBtn.Position },
	{ btn = linkBtn, scale = linkScale, pos = linkBtn.Position },
}

local function setMenu(open)
	menuOpen = open
	menuToken += 1

	local token = menuToken
	local n = #menuItems

	menuSetActive(open)

	-- Звезда прокручивается: открытие по часовой, закрытие обратно
	local spin = TweenInfo.new(0.75, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	if open then
		menuBtn.Rotation = 0
		TweenService:Create(menuBtn, spin, { Rotation = 360 }):Play()
	else
		menuBtn.Rotation = 360
		TweenService:Create(menuBtn, spin, { Rotation = 0 }):Play()
	end

	menuScale.Scale = 0.6

	TweenService:Create(
		menuScale,
		TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
		{ Scale = 1 }
	):Play()

	if not open and panelCloseHook then
		panelCloseHook()
	end

	for i, it in ipairs(menuItems) do
		if open then
			it.btn.Visible = true
			it.btn.Position = COLLAPSED
			it.scale.Scale = 0

			task.delay((i - 1) * 0.07, function()
				if menuToken ~= token then
					return
				end

				TweenService:Create(
					it.btn,
					TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Position = it.pos }
				):Play()

				TweenService:Create(
					it.scale,
					TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
					{ Scale = 1 }
				):Play()
			end)
		else
			task.delay((n - i) * 0.06, function()
				if menuToken ~= token then
					return
				end

				TweenService:Create(
					it.btn,
					TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In),
					{ Position = COLLAPSED }
				):Play()

				TweenService:Create(
					it.scale,
					TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In),
					{ Scale = 0 }
				):Play()

				task.delay(0.37, function()
					if menuToken == token then
						it.btn.Visible = false
					end
				end)
			end)
		end
	end
end

menuBtn.Activated:Connect(function()
	setMenu(not menuOpen)
end)

---------------------------------------------------------------- ФИЛЬТР ЛУЧА
local function refreshFilter()
	local char = player.Character
	local list = { ghostFolder }

	if char then
		table.insert(list, char)
	end

	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart

	if seat then
		table.insert(list, seat)

		for _, p in ipairs(seat:GetConnectedParts(true)) do
			table.insert(list, p)
		end

		local car = seat:FindFirstAncestorOfClass("Model")

		if car and #car:GetDescendants() > CFG.MaxVehicleSize then
			car = nil
		end

		while car and car.Parent and car.Parent:IsA("Model")
			and #car.Parent:GetDescendants() <= CFG.MaxVehicleSize do
			car = car.Parent
		end

		if car then
			table.insert(list, car)
		end
	end

	rayParams.FilterDescendantsInstances = list
end

---------------------------------------------------------------- ПРОВЕРКИ
local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function canGrab(part)
	if not part or not part:IsA("BasePart") then
		return false
	end

	if part.Anchored then
		return false
	end

	local char = player.Character

	if char and part:IsDescendantOf(char) then
		return false
	end

	local model = part:FindFirstAncestorOfClass("Model")

	if model and model:FindFirstChildOfClass("Humanoid") then
		return false
	end

	local root = getRoot()

	if root and part.AssemblyRootPart == root.AssemblyRootPart then
		return false
	end

	return true
end

local function isLooseModel(model)
	local count = 0

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Humanoid") then
			return false
		end

		if d:IsA("BasePart") then
			if d.Anchored then
				return false
			end

			count += 1

			if count > CFG.MaxPartsInObject then
				return false
			end
		end
	end

	return count > 0
end

local function collectObject(part)
	local top
	local m = part:FindFirstAncestorOfClass("Model")

	if m and isLooseModel(m) then
		top = m

		while top.Parent and top.Parent:IsA("Model")
			and isLooseModel(top.Parent) do
			top = top.Parent
		end
	end

	local roots, seen = {}, {}

	local function addRoot(p)
		local r = p.AssemblyRootPart

		if r and not seen[r] and not r.Anchored
			and #roots < CFG.MaxPartsInObject then
			seen[r] = true
			table.insert(roots, r)
		end
	end

	addRoot(part)

	if top then
		for _, d in ipairs(top:GetDescendants()) do
			if d:IsA("BasePart") then
				addRoot(d)
			end
		end
	end

	return roots, top
end

---------------------------------------------------------------- ТЯЖЕЛЫЙ ПРЕДМЕТ
local HEAVY_PROPS = PhysicalProperties.new(100, 0.5, 0, 1, 1)

local function makeHeavy(entry)
	if not CFG.HeavyWhenHeld then
		return
	end

	entry.heavy = {}

	local ok, parts = pcall(function()
		return entry.root:GetConnectedParts(true)
	end)

	if not ok then
		parts = { entry.root }
	end

	for _, p in ipairs(parts) do
		if p:IsA("BasePart") and not p.Anchored then
			table.insert(entry.heavy, {
				part = p,
				orig = p.CustomPhysicalProperties
			})

			p.CustomPhysicalProperties = HEAVY_PROPS
		end
	end
end

local function restoreHeavy(entry)
	if not entry.heavy then
		return
	end

	for _, h in ipairs(entry.heavy) do
		if h.part and h.part.Parent then
			h.part.CustomPhysicalProperties = h.orig
		end
	end

	entry.heavy = nil
end---------------------------------------------------------------- ПОДСВЕТКА
local function addHighlight(target, color)
	local hl = Instance.new("Highlight")
	hl.Adornee = target
	hl.FillColor = color
	hl.OutlineColor = color
	hl.FillTransparency = 1
	hl.OutlineTransparency = 1
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = target

	TweenService:Create(hl, TweenInfo.new(0.3), {
		FillTransparency = CFG.HighlightFill,
		OutlineTransparency = 0.4,
	}):Play()

	task.delay(0.8, function()
		if hl.Parent then
			TweenService:Create(
				hl,
				TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{
					FillTransparency = math.min(CFG.HighlightFill + 0.25, 0.95),
					OutlineTransparency = 0.15
				}
			):Play()
		end
	end)

	return hl
end

local function removeHighlight(hl)
	if not hl then
		return
	end

	TweenService:Create(hl, TweenInfo.new(0.25), {
		FillTransparency = 1,
		OutlineTransparency = 1
	}):Play()

	task.delay(0.3, function()
		if hl then
			hl:Destroy()
		end
	end)
end

local function flashHighlight(hl, time)
	if hl and hl.Parent then
		hl.FillTransparency = 0
		hl.OutlineTransparency = 0

		TweenService:Create(hl, TweenInfo.new(time or 0.6, Enum.EasingStyle.Quad), {
			FillTransparency = CFG.HighlightFill,
			OutlineTransparency = 0.4
		}):Play()
	end
end

---------------------------------------------------------------- ЗАМОРОЗКА
local function unfreezeGroup(g)
	for _, e in ipairs(g.entries) do
		frozenByRoot[e.root] = nil
		restoreHeavy(e)

		if e.ap then e.ap:Destroy() end
		if e.ao then e.ao:Destroy() end
		if e.att then e.att:Destroy() end
	end

	removeHighlight(g.hl)

	local i = table.find(frozenGroups, g)

	if i then
		table.remove(frozenGroups, i)
	end
end

---------------------------------------------------------------- ПЕРЕТАСКИВАНИЕ
local function currentRay()
	if held.isTouch then
		return camera:ScreenPointToRay(held.pos.X, held.pos.Y)
	end

	local m = UserInputService:GetMouseLocation()
	return camera:ViewportPointToRay(m.X, m.Y)
end

local function stopHold(cancel)
	if not held then
		return
	end

	local h = held
	held = nil

	if holdConn then
		holdConn:Disconnect()
		holdConn = nil
	end

	if h.freeze and not cancel then
		local g = { entries = {}, hl = nil }

		for _, e in ipairs(h.entries) do
			if e.root.Parent then
				e.root.AssemblyLinearVelocity = Vector3.zero
				e.root.AssemblyAngularVelocity = Vector3.zero
				e.ap.Position = e.root.Position

				if not e.ao then
					local ao = Instance.new("AlignOrientation")
					ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
					ao.Attachment0 = e.att
					ao.CFrame = e.root.CFrame
					ao.MaxTorque = math.huge
					ao.Responsiveness = CFG.Responsiveness
					ao.Parent = e.root
					e.ao = ao
				end

				frozenByRoot[e.root] = g
				table.insert(g.entries, e)
			else
				restoreHeavy(e)
				e.ap:Destroy()

				if e.ao then e.ao:Destroy() end
				e.att:Destroy()
			end
		end

		removeHighlight(h.hl)

		if #g.entries > 0 then
			g.hl = addHighlight(h.target, CFG.FreezeColor)
			table.insert(frozenGroups, g)

			task.delay(0.02, function()
				flashHighlight(g.hl, 0.6)
			end)

			if onFrozen then
				onFrozen(h.target, g.entries)
			end
		end
	else
		for _, e in ipairs(h.entries) do
			restoreHeavy(e)
			e.ap:Destroy()

			if e.ao then e.ao:Destroy() end
			e.att:Destroy()
		end

		removeHighlight(h.hl)
	end
end

local function holdStep()
	if not held then
		return
	end

	local ray = currentRay()
	local base = ray.Origin + ray.Direction * held.dist

	for i = #held.entries, 1, -1 do
		local e = held.entries[i]

		if e.root.Parent then
			e.ap.Position = base + e.offset
			e.root.AssemblyAngularVelocity *= 0.85
		else
			table.remove(held.entries, i)
		end
	end

	if not held.part.Parent or #held.entries == 0 then
		stopHold(true)
	end
end

local function startHold(part, hitPos, ray, input)
	local g = frozenByRoot[part.AssemblyRootPart]

	if g then
		unfreezeGroup(g)
	end

	local roots, top = collectObject(part)

	if #roots == 0 then
		return false
	end

	local freeze = (mode == "freeze")
	local color = freeze and CFG.FreezeColor or CFG.HighlightColor
	local entries = {}

	for _, r in ipairs(roots) do
		local att = Instance.new("Attachment")
		att.Name = "TK_Attachment"
		att.Parent = r

		local ap = Instance.new("AlignPosition")
		ap.Mode = Enum.PositionAlignmentMode.OneAttachment
		ap.Attachment0 = att
		ap.ApplyAtCenterOfMass = true
		ap.MaxForce = math.huge
		ap.MaxVelocity = 120
		ap.Responsiveness = CFG.Responsiveness
		ap.Position = r.Position
		ap.Parent = r

		local ao = nil

		if CFG.LockRotation then
			ao = Instance.new("AlignOrientation")
			ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
			ao.Attachment0 = att
			ao.CFrame = r.CFrame
			ao.MaxTorque = math.huge
			ao.Responsiveness = CFG.Responsiveness
			ao.Parent = r
		end

		local entry = {
			root = r,
			att = att,
			ap = ap,
			ao = ao,
			offset = r.Position - hitPos
		}

		makeHeavy(entry)
		table.insert(entries, entry)
	end

	held = {
		part = part,
		target = top or part,
		entries = entries,
		input = input,
		freeze = freeze,
		isTouch = input.UserInputType == Enum.UserInputType.Touch,
		pos = input.Position,
		dist = (hitPos - ray.Origin).Magnitude,
		hl = addHighlight(top or part, color),
	}

	if holdConn then
		holdConn:Disconnect()
	end

	holdConn = RunService.RenderStepped:Connect(holdStep)

	return true
end

---------------------------------------------------------------- ВВОД: ПОМОЩНИКИ
local function overOwnUI(pos)
	for _, g in ipairs(playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)) do
		if g:IsDescendantOf(gui) or g.Name == "JumpButton" then
			return true
		end
	end

	return false
end

local function inputRay(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return camera:ScreenPointToRay(input.Position.X, input.Position.Y)
	end

	local m = UserInputService:GetMouseLocation()
	return camera:ViewportPointToRay(m.X, m.Y)
end

local function posOf(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y)
	end

	return UserInputService:GetMouseLocation()
end

local function rayFromPos(isTouch, p)
	if isTouch then
		return camera:ScreenPointToRay(p.X, p.Y)
	end

	return camera:ViewportPointToRay(p.X, p.Y)
end

-- Обработчик «короткого тапа»: камера при этом вращается как обычно.
-- Сработает только если палец почти не сдвинулся и не держался долго.
local function makeTap(canStart, onTap)
	local tap = nil

	return function(_, state, input)
		if state == Enum.UserInputState.Begin then
			tap = nil

			if canStart() and not overOwnUI(input.Position) then
				tap = {
					input = input,
					isTouch = input.UserInputType == Enum.UserInputType.Touch,
					pos = posOf(input),
					t = os.clock(),
				}
			end

		elseif state == Enum.UserInputState.End then
			local t = tap
			tap = nil

			if t and (not t.isTouch or t.input == input)
				and os.clock() - t.t < 0.45
				and (posOf(input) - t.pos).Magnitude < 14
				and canStart() then

				local ray = rayFromPos(t.isTouch, t.pos)

				refreshFilter()

				local res = workspace:Raycast(
					ray.Origin,
					ray.Direction * 600,
					rayParams
				)

				if res then
					onTap(res.Instance, res)
				end
			end

		elseif state == Enum.UserInputState.Cancel then
			tap = nil
		end

		return Enum.ContextActionResult.Pass
	end
end

local function onTouch(_, state, input)
	-- В режимах 🎯 и 🔗 захват не нужен, камера крутится свободно
	if not mode or held or placeArmed or mode == "link" then
		return Enum.ContextActionResult.Pass
	end

	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end

	if overOwnUI(input.Position) then
		return Enum.ContextActionResult.Pass
	end

	local ray = inputRay(input)

	refreshFilter()

	local res = workspace:Raycast(
		ray.Origin,
		ray.Direction * CFG.MaxGrabDistance,
		rayParams
	)

	if res and canGrab(res.Instance) then
		if startHold(res.Instance, res.Position, ray, input) then
			return Enum.ContextActionResult.Sink
		end
	end

	return Enum.ContextActionResult.Pass
end

ContextActionService:BindActionAtPriority(
	"TelekinesisGrab",
	onTouch,
	false,
	Enum.ContextActionPriority.High.Value,
	Enum.UserInputType.Touch,
	Enum.UserInputType.MouseButton1
)

