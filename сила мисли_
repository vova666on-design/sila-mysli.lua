local function sortedDims(v)
	local t = { v.X, v.Y, v.Z }
	table.sort(t)
	return t
end

local function sameSize(a, b)
	if not a or not b then
		return false
	end

	local da = sortedDims(a)
	local db = sortedDims(b)

	for i = 1, 3 do
		if math.abs(da[i] - db[i]) > 0.5 + 0.05 * db[i] then
			return false
		end
	end

	return true
end

local function sizeOf(inst)
	if inst:IsA("Model") then
		local _, s = inst:GetBoundingBox()
		return s
	end

	return inst.Size
end

---------------------------------------------------------------- ПРОВЕРКА ЗАНЯТОЙ ПОЗИЦИИ
local function slotIsOccupied(item, movingTarget)
	if not item or not item.roots or #item.roots == 0 then
		return false
	end

	local char = player.Character
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local excluded = { ghostFolder }

	if char then
		table.insert(excluded, char)
	end

	if movingTarget then
		table.insert(excluded, movingTarget)
	end

	params.FilterDescendantsInstances = excluded

	for _, savedRoot in ipairs(item.roots) do
		if savedRoot.cf then
			local expectedPart = savedRoot.part
			local expectedSize = Vector3.new(2, 2, 2)

			if expectedPart and expectedPart.Parent then
				expectedSize = expectedPart.Size
			end

			local checkSize = expectedSize + Vector3.new(0.25, 0.25, 0.25)

			local ok, found = pcall(function()
				return workspace:GetPartBoundsInBox(
					savedRoot.cf,
					checkSize,
					params
				)
			end)

			if ok then
				for _, part in ipairs(found) do
					if part:IsA("BasePart")
						and part.Parent
						and not part:IsDescendantOf(ghostFolder) then

						local closeEnough =
							(part.Position - savedRoot.cf.Position).Magnitude
							<= math.max(1.25, expectedSize.Magnitude * 0.25)

						local sizeMatches =
							math.abs(part.Size.X - expectedSize.X) < 0.8
							and math.abs(part.Size.Y - expectedSize.Y) < 0.8
							and math.abs(part.Size.Z - expectedSize.Z) < 0.8

						if closeEnough and sizeMatches then
							return true
						end
					end
				end
			end
		end
	end

	return false
end

-- Память о занятых местах: место занято, если туда уже поставили предмет
-- (и он всё ещё рядом) или туда уже летит другой предмет
local function slotTaken(dest)
	if dest.reserved then
		return true
	end

	local pr = dest.placedRoot

	if pr and pr.Parent and dest.placedGoal
		and (pr.Position - dest.placedGoal).Magnitude < 1.5 then
		return true
	end

	dest.placedRoot = nil
	dest.placedGoal = nil

	return false
end

