-- Вращающиеся градиенты (крутятся только пока виден владелец)
local spinners = {}

local function addSpinner(grad, owner)
	table.insert(spinners, { grad = grad, owner = owner })
end

RunService.RenderStepped:Connect(function(dt)
	local step = dt * 60

	for i = #spinners, 1, -1 do
		local s = spinners[i]

		if not s.grad.Parent then
			table.remove(spinners, i)
		elseif s.owner.Visible then
			s.grad.Rotation = (s.grad.Rotation + step) % 360
		end
	end
end)

local defaultColor = ColorSequence.new(
	Color3.fromRGB(140, 100, 255),
	Color3.fromRGB(70, 200, 255)
)

-- Волна при нажатии
local function ripple(parent, size)
	size = size or 1

	local r = Instance.new("Frame")
	r.AnchorPoint = Vector2.new(0.5, 0.5)
	r.Position = UDim2.fromScale(0.5, 0.5)
	r.Size = UDim2.fromScale(0, 0)
	r.BackgroundColor3 = Color3.new(1, 1, 1)
	r.BackgroundTransparency = 0.35
	r.BorderSizePixel = 0
	r.ZIndex = 10
	r.Parent = parent

	Instance.new("UICorner", r).CornerRadius = UDim.new(1, 0)

	local t = TweenService:Create(
		r,
		TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = UDim2.fromScale(size, size),
			BackgroundTransparency = 1
		}
	)

	t.Completed:Once(function()
		r:Destroy()
	end)

	t:Play()
end

local function makeButton(icon, xOffset, accent)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(CFG.BtnSize, CFG.BtnSize)
	btn.AnchorPoint = Vector2.new(1, 0)
	btn.Position = UDim2.new(1, xOffset, 0, 10)
	btn.BackgroundColor3 = Color3.new(1, 1, 1)
	btn.BackgroundTransparency = 0.55
	btn.AutoButtonColor = false
	btn.ClipsDescendants = true
	btn.Text = ""
	btn.Parent = gui

	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

	local grad = Instance.new("UIGradient", btn)
	grad.Color = defaultColor
	addSpinner(grad, btn)

	local stroke = Instance.new("UIStroke", btn)
	stroke.Thickness = 2
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Transparency = 0.35

	local scale = Instance.new("UIScale", btn)

	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.fromScale(0.6, 0.6)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Text = icon
	label.Rotation = -8
	label.Parent = btn

	TweenService:Create(
		stroke,
		TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Transparency = 0.85 }
	):Play()

	TweenService:Create(
		label,
		TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Rotation = 8 }
	):Play()

	btn.Activated:Connect(function()
		scale.Scale = 0.7
		ripple(btn, 1)

		TweenService:Create(
			scale,
			TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
			{ Scale = 1 }
		):Play()
	end)

	local function setActive(on)
		grad.Color = on
			and ColorSequence.new(accent, accent:Lerp(Color3.new(1, 1, 1), 0.5))
			or defaultColor

		TweenService:Create(btn, TweenInfo.new(0.25), {
			BackgroundTransparency = on and 0.25 or 0.55
		}):Play()

		TweenService:Create(stroke, TweenInfo.new(0.25), {
			Color = on and accent or Color3.new(1, 1, 1)
		}):Play()
	end

	return btn, setActive, scale, label
end

